{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "novaterm",
  "version": "0.1.0",
  "identifier": "dev.novaterm.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NovaTerm",
        "width": 1100,
        "height": 700,
        "minWidth": 400,
        "minHeight": 260,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
